{
  "name": "dsh-voice-memory",
  "version": "1.0.2",
  "description": "DSH 语音记忆输入：本地 SenseVoice 识别中文与中英混说，自动润色并记住你对识别结果的修改，下次同样的发音直接识别正确。Local voice input with polish and a correction memory learned from your edits.",
  "license": "MIT",
  "author": "woxiangjieyan",
  "contributors": [
    {
      "name": "PensiveFei",
      "url": "https://github.com/PensiveFei/dsh-voice-scribe"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woxiangjieyan/dsh-voice-memory.git"
  },
  "homepage": "https://github.com/woxiangjieyan/dsh-voice-memory#readme",
  "bugs": {
    "url": "https://github.com/woxiangjieyan/dsh-voice-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 || >=0.1.1-rc.1 || >=0.1.2-alpha.0 || >=0.1.3-alpha.0 || >=0.1.5-alpha.0 || >=0.1.6-alpha.0 || >=0.1.7-alpha.0 || >=0.2.0-rc.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 || >=0.1.1-rc.1 || >=0.1.2-alpha.0 || >=0.1.3-alpha.0 || >=0.1.5-alpha.0 || >=0.1.6-alpha.0 || >=0.1.7-alpha.0 || >=0.2.0-rc.0",
    "@deepseek-ai/dsh-web-app": ">=0.1.0-rc.6 || >=0.1.1-rc.1 || >=0.1.2-alpha.0 || >=0.1.3-alpha.0 || >=0.1.5-alpha.0 || >=0.1.6-alpha.0 || >=0.1.7-alpha.0 || >=0.2.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": "1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "voice",
    "speech-to-text",
    "asr",
    "memory",
    "voice-input",
    "sensevoice"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.0"
  }
}
